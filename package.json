{
  "name": "doubao-translate2api",
  "version": "0.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "predev": "npm run build:ui",
    "build:ui": "node scripts/build-ui.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:ui && npm run build:plugin",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:ui && npm run build:plugin",
    "test": "vitest run",
    "test:ui": "node scripts/check-admin-ui.mjs",
    "smoke:local": "node scripts/local-smoke.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/session": "^11.1.3",
    "fastify": "^5.6.0",
    "lucide": "^1.52.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "openai": "^6.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
